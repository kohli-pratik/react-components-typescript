{
  "name": "react-components-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "build": "tsc -b && vite build",
    "preview": "NODE_ENV=development vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings 0",
    "test": "vitest --watch=false && vitest --config=vitest.jsdom.config.ts --watch=false",
    "test:coverage": "vitest run --coverage",
    "test:headless": "vitest",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:axe": "vitest --config=vitest.jsdom.config.ts",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "chromatic": "npx chromatic"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/react-vite": "^10.4.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.8",
    "chromatic": "^17.4.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-dom": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^5.9.0",
    "eslint-plugin-storybook": "^10.4.4",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "prettier": "3.8.4",
    "storybook": "^10.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.9",
    "vitest-axe": "^1.0.0-pre.3",
    "vitest-browser-react": "^2.2.0"
  }
}
