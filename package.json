{
  "name": "react-components-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --watch=false && vitest --config=vitest.jsdom.config.ts --watch=false",
    "test:coverage": "vitest run --coverage",
    "test:headless": "vitest",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:axe": "vitest --config=vitest.jsdom.config.ts",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "chromatic": "npx chromatic"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.39.3",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "chromatic": "^16.2.0",
    "eslint": "^9.39.3",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-dom": "^2.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-react-x": "^2.0.0",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "storybook": "^10.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vitest-axe": "^1.0.0-pre.3",
    "vitest-browser-react": "^2.2.0"
  }
}
